# Local runtime mode. Production is set by Kubernetes and does not load dotenv files.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false

# PostgreSQL / Supabase direct connection. Use the dedicated rfc_backend role.
# VerifyFull uses the operating-system trust store when Root Certificate is omitted.
# For a private/provider CA, mount the reviewed root and set its absolute path as below.
ConnectionStrings__RfcDatabase=Host=YOUR_DATABASE_HOST;Port=5432;Database=YOUR_DATABASE_NAME;Username=rfc_backend;Password=replace-with-secret-manager-value;SSL Mode=VerifyFull;Trust Server Certificate=false;Root Certificate=/absolute/path/to/provider-root-ca.pem;

# Redis. docker-compose overrides the host with the local redis service name.
Redis__ConnectionString=localhost:6379,abortConnect=false

# First-run staff seed. Set a strong password locally, then remove SeedAdmin__Password after the first successful migration/seed.
SeedAdmin__Name=RFC Manager
SeedAdmin__Email=manager@example.com
SeedAdmin__Password=
SeedAdmin__Role=manager

# Browser origins allowed to call the cookie-auth API.
Cors__AllowedOrigins=http://localhost:3000,http://127.0.0.1:3000
PublicAppUrl=http://localhost:3000

# ASP.NET binding override.
ASPNETCORE_URLS=http://localhost:5242

# Stripe. Secret values are backend-only. Publishable key is public frontend config.
Stripe__SecretKey=sk_test_replace
Stripe__WebhookSecret=whsec_replace
Stripe__PublishableKey=pk_test_replace

# Twilio SMS notifications.
Twilio__AccountSid=AC_replace
Twilio__AuthToken=replace
Twilio__FromPhone=+440000000000

# SendGrid email notifications.
SendGrid__ApiKey=SG_replace
SendGrid__FromEmail=orders@example.com
SendGrid__FromName=RFC Watford

# Google Maps delivery geocoding and route display.
GoogleMaps__ApiKey=replace
VITE_GOOGLE_MAPS_API_KEY=replace

# Frontend API base. Leave as /api for Vite proxy/Nginx reverse proxy.
VITE_API_BASE_URL=/api

# Local docker-compose database password. Compose has no fallback and is not a production deployment path.
POSTGRES_PASSWORD=replace-with-random-local-password

# Production startup never migrates automatically. Run the approved backend image
# once with --migrate-only using infrastructure/k8s/operations before promotion.
