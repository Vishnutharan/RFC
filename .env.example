# PostgreSQL / Supabase
ConnectionStrings__RfcDatabase=Host=aws-0-eu-west-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.plvhnddicdquknwjemsr;Password=replace-me;SSL Mode=Require;Trust Server Certificate=true;Pooling=false;

# First-run staff seed. Set a strong password locally, then remove SeedAdmin__Password after the first successful migration/seed.
SeedAdmin__Name=RFC Manager
SeedAdmin__Email=manager@example.com
SeedAdmin__Password=
SeedAdmin__Role=manager

# Browser origins allowed to call the cookie-auth API.
Cors__AllowedOrigins=http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.example
PublicAppUrl=https://your-production-domain.example

# ASP.NET binding override.
ASPNETCORE_URLS=http://localhost:5242

# Stripe. Secret values are backend-only. Publishable key is public frontend config.
Stripe__SecretKey=sk_test_replace
Stripe__WebhookSecret=whsec_replace
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace

# Twilio SMS notifications.
Twilio__AccountSid=AC_replace
Twilio__AuthToken=replace
Twilio__FromPhone=+440000000000

# SendGrid email notifications.
SendGrid__ApiKey=SG_replace
SendGrid__FromEmail=orders@example.com
SendGrid__FromName=RFC Watford

# Google Maps delivery geocoding and route display.
GoogleMaps__ApiKey=replace
VITE_GOOGLE_MAPS_API_KEY=replace

# Frontend API base. Leave as /api for Vite proxy/Nginx reverse proxy.
VITE_API_BASE_URL=/api

# Local docker-compose database password.
POSTGRES_PASSWORD=postgres
