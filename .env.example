# Backend database. Rotate any previously committed password before using this.
ConnectionStrings__RfcDatabase=Host=db.eakakbgpkimrlrjaeisa.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=replace-me;SSL Mode=Require;Trust Server Certificate=true;

# Cookie-auth staff login. Generate this hash from your real admin password.
Admin__Email=staff@example.com
Admin__PasswordHash=pbkdf2-sha256$210000$replace-salt$replace-hash
Admin__Role=staff

# Comma-separated allowed browser origins.
Cors__AllowedOrigins=http://localhost:3000,http://127.0.0.1:3000,https://your-production-domain.example

# Optional ASP.NET binding override.
ASPNETCORE_URLS=http://localhost:5242

# Frontend public Supabase config, if Supabase client access is used.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-key
