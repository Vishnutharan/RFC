: 0;\n  font-size: 1rem;\n}\n\n.order-again-card {\n  min-height: 220px;\n  background: linear-gradient(145deg, rgba(21,23,28,0.92), rgba(30,32,40,0.82));\n}\n\n.order-collage {\n  width: 100%;\n  height: 86px;\n  margin-bottom: 12px;\n  border-radius: 16px;\n}\n\n.promo-countdown {\n  padding: 17px;\n  border-radius: var(--radius-card);\n  color: var(--color-text-inverse);\n  background: linear-gradient(135deg, #F4C76B, var(--color-accent-primary));\n  font-weight: 900;\n}\n\n.profile-detail-card {\n  padding: 16px;\n  border-radius: var(--radius-card);\n  background: rgba(255,255,255,0.045);\n  border: 1px solid var(--color-border-subtle);\n}\n\n.consent-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--color-text-secondary);\n  font-size: 0.86rem;\n  font-weight: 800;\n}\n\n.consent-row input {\n  width: 18px;\n  min-height: 18px;\n  accent-color: var(--color-accent-primary);\n}\n\n.danger-zone {\n  margin-top: 18px;\n  color: #FFB4B1;\n  background: rgba(217,83,79,0.10);\n  border-color: rgba(217,83,79,0.25);\n}\n\n.danger-zone h5 {\n  margin: 0 0 5px;\n  font-size: 0.96rem;\n}\n\n.danger-zone p {\n  margin: 0 0 11px;\n  color: var(--color-text-secondary);\n}\n\n/* Reviews */\n.reviews-shell {\n  display: grid;\n  gap: 20px;\n}\n\n.reviews-summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 18px;\n  border-radius: var(--radius-card);\n  background: linear-gradient(145deg, rgba(232,169,63,0.12), rgba(30,32,40,0.82));\n  border: 1px solid var(--color-border-subtle);\n}\n\n.reviews-summary h3 {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0;\n  font-family: var(--font-display);\n  font-size: 1.7rem;\n}\n\n.reviews-form,\n.review-card {\n  padding: 18px;\n}\n\n.review-grid {\n  column-count: 2;\n  column-gap: 16px;\n}\n\n.review-card {\n  display: inline-block;\n  width: 100%;\n  margin: 0 0 16px;\n  break-inside: avoid;\n}\n\n.review-card .item-modal-image 