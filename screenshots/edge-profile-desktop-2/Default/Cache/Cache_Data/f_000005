ound: rgba(74,222,128,0.12);\n  border-color: rgba(74,222,128,0.24);\n}\n\n.status-timeline {\n  display: grid;\n  gap: 14px;\n}\n\n.status-step {\n  position: relative;\n  display: grid;\n  grid-template-columns: 54px minmax(0, 1fr);\n  gap: 12px;\n  align-items: center;\n  padding: 12px;\n  border-radius: 18px;\n  background: rgba(255,255,255,0.045);\n  border: 1px solid var(--color-border-subtle);\n}\n\n.step-circle {\n  width: 54px;\n  height: 54px;\n  display: grid;\n  place-items: center;\n  border-radius: 18px;\n  color: var(--color-text-secondary);\n  background: rgba(255,255,255,0.055);\n}\n\n.status-step.completed .step-circle,\n.status-step.active .step-circle {\n  color: var(--color-text-inverse);\n  background: var(--color-accent-primary);\n}\n\n.status-step.active .step-circle {\n  animation: pulse-glow 1.8s ease-in-out infinite;\n}\n\n.step-label {\n  display: block;\n  font-weight: 900;\n}\n\n.step-copy {\n  display: block;\n  margin-top: 3px;\n  color: var(--color-text-secondary);\n  font-size: 0.83rem;\n}\n\n.tracker-message {\n  margin: 18px 0;\n  padding: 15px;\n  border-radius: var(--radius-card);\n  color: var(--color-text-primary);\n  background: rgba(232,169,63,0.10);\n  border: 1px solid rgba(232,169,63,0.20);\n  font-weight: 850;\n}\n\n.tracker-message.cancelled {\n  color: #FFB4B1;\n  background: rgba(217,83,79,0.13);\n  border-color: rgba(217,83,79,0.28);\n}\n\n.delivery-map-panel {\n  overflow: hidden;\n}\n\n.delivery-map {\n  height: 280px;\n}\n\n.delivery-map-panel p,\n.delivery-map-panel span {\n  display: block;\n  margin: 0;\n  padding: 10px 14px;\n  color: var(--color-text-secondary);\n  font-size: 0.88rem;\n  font-weight: 850;\n}\n\n.fallback-route {\n  position: relative;\n  height: 230px;\n  overflow: hidden;\n  background:\n    linear-gradient(180deg, rgba(232,169,63,0.08), rgba(74,222,128,0.04)),\n    #11131A;\n}\n\n.fallback-route svg {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.route-dash {\n